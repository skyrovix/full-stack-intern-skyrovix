PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Cashfree Payments PG Credentials (Backend Only - Keep Secret)
CASHFREE_CLIENT_ID=your_cashfree_app_id
CASHFREE_CLIENT_SECRET=your_cashfree_secret_key
CASHFREE_ENVIRONMENT=production
CASHFREE_API_VERSION=2023-08-01

# Webhook configuration
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret

# Security & Auth
JWT_SECRET=your_super_secret_jwt_key
ADMIN_SECRET=your_admin_master_key

# WhatsApp Group URL
BATCH_1_WHATSAPP_URL=https://chat.whatsapp.com/your_batch_link

# Supabase Database Configuration (Optional Sync)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
