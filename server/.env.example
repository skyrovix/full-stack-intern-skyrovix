# Skyrovix Batch 1 Platform Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173
SERVER_URL=http://localhost:5000

# Cashfree Payments PG Credentials (Backend Only - NEVER expose to frontend)
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
CASHFREE_ENVIRONMENT=sandbox
CASHFREE_API_VERSION=2023-08-01

# Webhook configuration
CASHFREE_WEBHOOK_SECRET=your_cashfree_webhook_secret

# Security & Auth
JWT_SECRET=skyrovix_batch1_secure_super_jwt_secret_key_2026_dev
ADMIN_SECRET=skyrovix_admin_master_key_2026

# WhatsApp Group URL (can also be changed via Admin Dashboard)
BATCH_1_WHATSAPP_URL=https://chat.whatsapp.com/SkyrovixBatch1Official

# Database Configuration (MySQL Server)
DB_TYPE=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=skyrovix

# Email Dispatch Configuration (SMTP / Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM="Skyrovix <your_email@gmail.com>"
GMAIL_USER=your_email@gmail.com

